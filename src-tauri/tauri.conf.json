{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "笺藏",
  "mainBinaryName": "doc-archive-manager",
  "version": "0.2.2",
  "identifier": "cn.jiancang.archive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "笺藏 · 文档归档管家", "width": 1440, "height": 940, "minWidth": 1080, "minHeight": 720, "center": true, "backgroundColor": "#f7f8fa" }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "实体文档收发登记与加密归档",
    "category": "Productivity",
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
